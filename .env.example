# ==============================================================================
# UNDRLLANDING ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Storefront & Tenant Configuration
# ------------------------------------------------------------------------------
# Mode: 'client' (individual shop) or 'flagship' (central Undrlla platform)
TENANT_MODE=flagship

# Enabled feature modules (comma-separated): shop, housing, unet, recruiting
FEATURES=shop

# ------------------------------------------------------------------------------
# 2. Medusa 2.0 Store API Configuration
# ------------------------------------------------------------------------------
# URL of the Medusa 2.0 backend instance (undreseller)
MEDUSA_BACKEND_URL=http://localhost:9000

# Medusa Publishable API Key (safe for client bundle)
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_test_01H9Y78Z9A1B2C3D4E5F6G7H8J

# ------------------------------------------------------------------------------
# 3. Fiat Payment Configuration (Paddle Billing MoR)
# ------------------------------------------------------------------------------
# Paddle Client Token for overlay checkout
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_a1b2c3d4e5f6g7h8j9k0

# Paddle Environment: 'sandbox' or 'live'
NEXT_PUBLIC_PADDLE_ENV=sandbox

# ------------------------------------------------------------------------------
# 4. Crypto Payment Configuration (SHKeeper)
# ------------------------------------------------------------------------------
# URL of the self-hosted SHKeeper crypto processor node
SHKEEPER_API_URL=http://localhost:8080

# ------------------------------------------------------------------------------
# 5. Waitlist Telegram Bot Alerts (/api/waitlist)
# ------------------------------------------------------------------------------
# Telegram Bot API token from @BotFather for real-time waitlist notifications
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyZ

# Telegram Chat ID or Channel ID where alerts are delivered (e.g., -100123456789 or @channel)
TELEGRAM_CHAT_ID=-1001234567890

# ------------------------------------------------------------------------------
# 6. Social Media & Creator Contact Links (Optional - empty = hidden)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SOCIAL_GITHUB=https://github.com/UnderUndre
NEXT_PUBLIC_SOCIAL_TWITTER=https://x.com/UnderUndre
NEXT_PUBLIC_SOCIAL_TELEGRAM=https://t.me/UnderUndre
NEXT_PUBLIC_SOCIAL_YOUTUBE=https://youtube.com/@UnderUndre
NEXT_PUBLIC_SOCIAL_REDDIT=https://reddit.com/r/UnderUndre
NEXT_PUBLIC_SOCIAL_DISCORD=https://discord.gg/UnderUndre
NEXT_PUBLIC_SOCIAL_LINKEDIN=https://www.linkedin.com/in/underundre


# ------------------------------------------------------------------------------
# 7. Project Name (Optional - empty = hidden, available values: undreseller, undrlla)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_PROJECT_NAME=