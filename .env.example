# ==============================================================================
# UNDRLLANDING — RUNTIME & BUILD ENVIRONMENT CONFIGURATION (.env.example)
#
# Usage:
#   cp .env.example .env
#
# Scope:
#   - Local development (pnpm dev, pnpm build)
#   - Production stack container runtime (.env file read by docker compose)
#
# Note: Variables prefixed with NEXT_PUBLIC_* are inlined into the client
# bundle at build time. Runtime secrets (TELEGRAM_*, UMAMI_*) flow via
# docker-compose env_file and are never baked into the Docker image.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Multi-Project Landing Engine Configuration
# ------------------------------------------------------------------------------
# Active project slug corresponding to a projects/<slug> directory.
# Default: 'underundre' (Productized Engineering Bureau).
NEXT_PUBLIC_PROJECT_NAME=underundre

# ------------------------------------------------------------------------------
# 2. Inbound Lead Intake & Telegram Dispatch (/api/lead)
# ------------------------------------------------------------------------------
# Telegram Bot API token from @BotFather for instant inbound lead notifications.
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyZ

# Telegram Chat ID or Channel ID where lead notifications are delivered.
# Personal chat: e.g. 123456789 | Group/Channel: e.g. -1001234567890
TELEGRAM_ALERT_CHAT_ID=-1001234567890

# Trusted upstream header carrying client IP set by the edge proxy (Caddy / Cloudflare).
# Default: 'x-real-ip'. Fallback order: x-real-ip -> x-forwarded-for (first hop) -> 127.0.0.1.
LEAD_TRUSTED_IP_HEADER=x-real-ip

# Optional secondary webhook endpoint receiving identical JSON lead payloads.
# Leave empty if Telegram is your sole dispatch channel.
LEAD_WEBHOOK_URL=

# ------------------------------------------------------------------------------
# 3. Privacy-Preserving Analytics (Umami Stack)
# ------------------------------------------------------------------------------
# Umami Website ID generated in your Umami dashboard (Websites -> Add Website).
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# First-party tracker script path served from /public (ad-blocker immune, CSP 'self').
# Default: '/umami-tracker.js'.
NEXT_PUBLIC_UMAMI_SRC=/umami-tracker.js

# Internal or external URL of the Umami collection instance.
# When using the bundled docker-compose stack on the VPS: 'http://umami:3000'.
# When using an external Umami instance: 'https://umami.yourdomain.com'.
UMAMI_UPSTREAM_URL=http://umami:3000

# Secret key used for cryptographic hashing in Umami.
# Generate: openssl rand -hex 32
UMAMI_APP_SECRET=replace_with_64_char_hex_secret

# Password for the bundled PostgreSQL database service (umami-db).
# Generate: openssl rand -hex 16
UMAMI_DB_PASSWORD=replace_with_32_char_hex_password

# ------------------------------------------------------------------------------
# 4. Post-Submit Triage & Calendar Booking (Optional)
# ------------------------------------------------------------------------------
# Cal.com (or Google Meet / Calendly) link shown on the Thank-You screen
# after a lead submits the brief. Leave empty to hide the calendar booking button.
NEXT_PUBLIC_CAL_TRIAGE_URL=

# ------------------------------------------------------------------------------
# 5. Social Media & Direct Contact Channels
# ------------------------------------------------------------------------------
# Channels render in the footer and direct contact section if the URL is set.
NEXT_PUBLIC_SOCIAL_GITHUB=https://github.com/UnderUndre
NEXT_PUBLIC_SOCIAL_TWITTER=https://x.com/UnderUndre
NEXT_PUBLIC_SOCIAL_TELEGRAM=https://t.me/UnderUndre
NEXT_PUBLIC_SOCIAL_YOUTUBE=https://youtube.com/@UnderUndre
NEXT_PUBLIC_SOCIAL_REDDIT=https://reddit.com/r/UnderUndre
NEXT_PUBLIC_SOCIAL_DISCORD=https://discord.gg/UnderUndre
NEXT_PUBLIC_SOCIAL_LINKEDIN=https://www.linkedin.com/in/underundre
NEXT_PUBLIC_SOCIAL_UPWORK=https://www.upwork.com/freelancers/~01b67f7db2c4484db2
NEXT_PUBLIC_SOCIAL_TRAILBLAZER=https://www.salesforce.com/trailblazer/underundre
NEXT_PUBLIC_SOCIAL_SLACK=https://underundre.slack.com/
NEXT_PUBLIC_SOCIAL_INSTAGRAM=https://www.instagram.com/underundre/

# Comma-separated list of active direct contact channels shown in the contact block:
# Allowed values: twitter | linkedin | slack | telegram | upwork | trailblazer | github | youtube | reddit | discord
# Unlisted channels remain visible only as static footer profile links.
# Leave empty to treat all configured channels as contactable.
NEXT_PUBLIC_CONTACT_CHANNELS=twitter,slack,linkedin
