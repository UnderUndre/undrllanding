# ==============================================================================
# UNDRLLANDING ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Multi-Project Landing Engine Configuration
# ------------------------------------------------------------------------------
# Active project slug: 'underundre' (Productized Engineering Bureau) or 'undrlla' (Medusa Marketplace)
NEXT_PUBLIC_PROJECT_NAME=underundre

# ------------------------------------------------------------------------------
# 2. Inbound Lead Alerts & Telegram Dispatch (/api/lead)
# ------------------------------------------------------------------------------
# Telegram Bot API token from @BotFather for instant inbound lead dispatches
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyZ

# Telegram Chat ID or Channel ID where lead notifications are delivered (e.g., -100123456789 or @channel)
TELEGRAM_ALERT_CHAT_ID=-1001234567890

# ------------------------------------------------------------------------------
# 3. Privacy-Preserving Self-Hosted Analytics (Umami)
# ------------------------------------------------------------------------------
# Umami Website ID generated in your self-hosted Umami dashboard
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# Full URL to your Umami tracking script (defaults to https://analytics.underundre.com/script.js)
NEXT_PUBLIC_UMAMI_SRC=https://analytics.underundre.com/script.js

# ------------------------------------------------------------------------------
# 4. Social Media & Bureau Contact Links (Optional - empty = hidden)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SOCIAL_GITHUB=https://github.com/UnderUndre
NEXT_PUBLIC_SOCIAL_TWITTER=https://x.com/UnderUndre
NEXT_PUBLIC_SOCIAL_TELEGRAM=https://t.me/UnderUndre
NEXT_PUBLIC_SOCIAL_YOUTUBE=https://youtube.com/@UnderUndre
NEXT_PUBLIC_SOCIAL_REDDIT=https://reddit.com/r/UnderUndre
NEXT_PUBLIC_SOCIAL_DISCORD=https://discord.gg/UnderUndre
NEXT_PUBLIC_SOCIAL_LINKEDIN=https://www.linkedin.com/in/underundre
