# ==============================================================================
# UNDRLLANDING — DEPLOY DRIVER CONFIG (.env.production)
# Lives in the LOCAL checkout of undrllanding (repo being deployed).
# Read by undevops scripts/deploy/deploy.sh via load_env ".env.production".
# Server-side runtime/build env lives separately in .env (.env.example template).
# ==============================================================================

# SSH alias (from ~/.ssh/config) or user@host of the VPS
PROD_SSH_HOST=underundre-vps

# Target directory on the server (this repo is cloned here)
REMOTE_APP_DIR=/root/apps/underundre-landing

# Git clone URL of THIS repo (defaults to `git remote get-url origin`)
REMOTE_REPO_URL=git@github.com:UnderUndre/undrllanding.git

# Leave empty — the landing sits at repo root (no monorepo subdir)
APP_SUBDIR=

# Optional Telegram deploy notifications (undevops common.sh)
TELEGRAM_NOTIFY_TOKEN=
TELEGRAM_NOTIFY_CHAT_ID=

# ------------------------------------------------------------------------------
# Umami analytics stack (deploys WITH the landing — see docker-compose.yml).
# Dashboard: ssh -L 3001:127.0.0.1:3001 $PROD_SSH_HOST → http://localhost:3001
# Default login admin/umami on a fresh database — CHANGE IT immediately.
# Generate secrets: openssl rand -hex 32
# ------------------------------------------------------------------------------
UMAMI_APP_SECRET=
UMAMI_TWO_FACTOR_ENCRYPTION_KEY=
UMAMI_DB_PASSWORD=
# Collect endpoint proxy target (docker-network name of the umami service)
UMAMI_UPSTREAM_URL=http://umami:3000
