# ==============================================================================
# UNDRLLANDING — PRODUCTION DEPLOY & SERVER CONFIGURATION (.env.production.example)
#
# Usage:
#   cp .env.production.example .env.production
#
# Scope:
#   - LOCAL: Read by undevops scripts/deploy/deploy.sh for SSH transport & git sync
#   - REMOTE: Uploaded to $REMOTE_APP_DIR/.env on first deploy to configure the
#     production Docker stack (landing, umami, and umami-db containers).
#
# Security:
#   Never commit .env.production to source control (strictly gitignored).
# ==============================================================================

# ==============================================================================
# PART A: DEPLOY DRIVER & SSH TRANSPORT (Read locally by deploy.sh)
# ==============================================================================

# ------------------------------------------------------------------------------
# A1. Remote Server & SSH Connection
# ------------------------------------------------------------------------------
# SSH host alias (from ~/.ssh/config) or user@host of the target VPS.
PROD_SSH_HOST=underundre-vps

# Absolute path on the VPS where the repository and stack are deployed.
REMOTE_APP_DIR=/root/apps/underundre-landing

# Optional: Path to dedicated SSH deploy key on the VPS for git operations.
# server-deploy.sh auto-fixes permissions (chmod 600) and probes git auth.
# DEPLOY_SSH_KEY=/root/.ssh/undrllanding_deploy

# ------------------------------------------------------------------------------
# A2. Git Remote & Repository Sync
# ------------------------------------------------------------------------------
# Git clone URL of this repository (defaults to `git remote get-url origin`).
REMOTE_REPO_URL=git@github.com:UnderUndre/undrllanding.git

# Subdirectory within the repo if running as a monorepo (empty for root).
APP_SUBDIR=

# ------------------------------------------------------------------------------
# A3. Deploy Notifications (Optional)
# ------------------------------------------------------------------------------
# Telegram Bot API credentials for automated deployment success/failure alerts.
TELEGRAM_NOTIFY_TOKEN=
TELEGRAM_NOTIFY_CHAT_ID=

# ==============================================================================
# PART B: PRODUCTION STACK RUNTIME (.env uploaded to server on first deploy)
# ==============================================================================

# ------------------------------------------------------------------------------
# B1. Multi-Project Landing Engine Configuration
# ------------------------------------------------------------------------------
# Active project slug for production build (must exist in projects/<slug>).
NEXT_PUBLIC_PROJECT_NAME=underundre

# ------------------------------------------------------------------------------
# B2. Inbound Lead Intake & Telegram Dispatch (/api/lead)
# ------------------------------------------------------------------------------
# Production Telegram Bot API token from @BotFather for inbound client briefs.
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyZ

# Telegram Chat ID or Channel ID where incoming briefs are delivered.
TELEGRAM_ALERT_CHAT_ID=-1001234567890

# Trusted header set by Caddy edge proxy carrying real client IP.
LEAD_TRUSTED_IP_HEADER=x-real-ip

# Optional secondary webhook endpoint.
LEAD_WEBHOOK_URL=

# ------------------------------------------------------------------------------
# B3. Privacy-Preserving Analytics (Bundled Umami Stack)
# ------------------------------------------------------------------------------
# Website ID generated in the Umami dashboard (https://analytics.yourdomain.com).
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# First-party tracker script served same-origin from /public (ad-blocker immune).
NEXT_PUBLIC_UMAMI_SRC=/umami-tracker.js

# Internal Docker-network URL of the Umami collection service.
UMAMI_UPSTREAM_URL=http://umami:3000

# Secret key for Umami session encryption (generate: openssl rand -hex 32).
UMAMI_APP_SECRET=replace_with_64_char_hex_secret

# Password for the bundled PostgreSQL database service (umami-db).
UMAMI_DB_PASSWORD=replace_with_32_char_hex_password

# ------------------------------------------------------------------------------
# B4. Post-Submit Triage & Calendar Booking (Optional)
# ------------------------------------------------------------------------------
# Cal.com (or Google Meet / Calendly) link shown on the Thank-You screen.
NEXT_PUBLIC_CAL_TRIAGE_URL=

# ------------------------------------------------------------------------------
# B5. Social Media & Direct Contact Channels
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SOCIAL_GITHUB=https://github.com/UnderUndre
NEXT_PUBLIC_SOCIAL_TWITTER=https://x.com/UnderUndre
NEXT_PUBLIC_SOCIAL_TELEGRAM=https://t.me/UnderUndre
NEXT_PUBLIC_SOCIAL_YOUTUBE=https://youtube.com/@UnderUndre
NEXT_PUBLIC_SOCIAL_REDDIT=https://reddit.com/r/UnderUndre
NEXT_PUBLIC_SOCIAL_DISCORD=https://discord.gg/UnderUndre
NEXT_PUBLIC_SOCIAL_LINKEDIN=https://www.linkedin.com/in/underundre
NEXT_PUBLIC_SOCIAL_UPWORK=https://www.upwork.com/freelancers/~01b67f7db2c4484db2
NEXT_PUBLIC_SOCIAL_TRAILBLAZER=https://www.salesforce.com/trailblazer/underundre
NEXT_PUBLIC_SOCIAL_SLACK=https://underundre.slack.com/
NEXT_PUBLIC_SOCIAL_INSTAGRAM=https://www.instagram.com/underundre/

# Comma-separated list of active direct contact channels:
NEXT_PUBLIC_CONTACT_CHANNELS=twitter,slack,linkedin
