# syntax=docker/dockerfile:1
FROM node:22-alpine AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@10.15.1 --activate

# Stage 1: Dependencies
FROM base AS deps
WORKDIR /app
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

# Stage 2: Builder
# NEXT_PUBLIC_* variables are inlined into the client bundle at build time —
# they MUST be provided as build args (docker compose reads them from .env).
# Secrets (TELEGRAM_BOT_TOKEN, TELEGRAM_ALERT_CHAT_ID) are runtime-only:
# injected via compose env_file, never baked into the image (.dockerignore
# excludes .env* from the build context).
FROM base AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .

ARG NEXT_PUBLIC_PROJECT_NAME=underundre
ARG NEXT_PUBLIC_UMAMI_WEBSITE_ID
ARG NEXT_PUBLIC_UMAMI_SRC
ARG NEXT_PUBLIC_CAL_TRIAGE_URL
ARG NEXT_PUBLIC_CONTACT_CHANNELS
ARG NEXT_PUBLIC_SOCIAL_GITHUB
ARG NEXT_PUBLIC_SOCIAL_TWITTER
ARG NEXT_PUBLIC_SOCIAL_TELEGRAM
ARG NEXT_PUBLIC_SOCIAL_YOUTUBE
ARG NEXT_PUBLIC_SOCIAL_REDDIT
ARG NEXT_PUBLIC_SOCIAL_DISCORD
ARG NEXT_PUBLIC_SOCIAL_LINKEDIN
ARG NEXT_PUBLIC_SOCIAL_UPWORK
ARG NEXT_PUBLIC_SOCIAL_TRAILBLAZER
ARG NEXT_PUBLIC_SOCIAL_SLACK

ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production
ENV NEXT_PUBLIC_PROJECT_NAME=$NEXT_PUBLIC_PROJECT_NAME
ENV NEXT_PUBLIC_UMAMI_WEBSITE_ID=$NEXT_PUBLIC_UMAMI_WEBSITE_ID
ENV NEXT_PUBLIC_UMAMI_SRC=$NEXT_PUBLIC_UMAMI_SRC
ENV NEXT_PUBLIC_CAL_TRIAGE_URL=$NEXT_PUBLIC_CAL_TRIAGE_URL
ENV NEXT_PUBLIC_CONTACT_CHANNELS=$NEXT_PUBLIC_CONTACT_CHANNELS
ENV NEXT_PUBLIC_SOCIAL_GITHUB=$NEXT_PUBLIC_SOCIAL_GITHUB
ENV NEXT_PUBLIC_SOCIAL_TWITTER=$NEXT_PUBLIC_SOCIAL_TWITTER
ENV NEXT_PUBLIC_SOCIAL_TELEGRAM=$NEXT_PUBLIC_SOCIAL_TELEGRAM
ENV NEXT_PUBLIC_SOCIAL_YOUTUBE=$NEXT_PUBLIC_SOCIAL_YOUTUBE
ENV NEXT_PUBLIC_SOCIAL_REDDIT=$NEXT_PUBLIC_SOCIAL_REDDIT
ENV NEXT_PUBLIC_SOCIAL_DISCORD=$NEXT_PUBLIC_SOCIAL_DISCORD
ENV NEXT_PUBLIC_SOCIAL_LINKEDIN=$NEXT_PUBLIC_SOCIAL_LINKEDIN
ENV NEXT_PUBLIC_SOCIAL_UPWORK=$NEXT_PUBLIC_SOCIAL_UPWORK
ENV NEXT_PUBLIC_SOCIAL_TRAILBLAZER=$NEXT_PUBLIC_SOCIAL_TRAILBLAZER
ENV NEXT_PUBLIC_SOCIAL_SLACK=$NEXT_PUBLIC_SOCIAL_SLACK

RUN pnpm build:underundre

# Stage 3: Runner
FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

COPY --from=builder /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next ./.next
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./package.json

USER nextjs
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:3000/ || exit 1

CMD ["npm", "start"]
